# Men Women Psychology: environment configuration
# Copy to ".env" and fill in as needed. Every value has a safe default, so the
# site builds and runs with NONE of these set. Ads and analytics stay OFF until
# explicitly enabled here.

# ---- Canonical site URL (used for sitemap, canonical tags, Open Graph) ----
SITE_URL="https://menwomenpsychology.com"

# ---- Google AdSense ----
# The publisher ID ships as a default in src/config.ts (it is public and also
# lives in /ads.txt), and ads ship ENABLED so the AdSense loader is present for
# review and Auto ads once the account is approved. Set these only to override:
#   - PUBLIC_ADSENSE_CLIENT: a different ca-pub-XXXXXXXXXXXXXXXX id
#   - PUBLIC_ADS_ENABLED="false": suppress ads (e.g. a local preview or staging)
# PUBLIC_ADSENSE_CLIENT="ca-pub-7759354256906782"
# PUBLIC_ADS_ENABLED="true"

# ---- Analytics (Firebase / Google Analytics) ----
# Set to "true" to load analytics in production. Defaults to off so local dev
# and previews collect nothing. The Firebase web config below is public (it is
# not a secret) and ships with sensible project defaults; override only if you
# point the site at a different Firebase project.
PUBLIC_ANALYTICS_ENABLED="false"
# PUBLIC_FIREBASE_API_KEY=""
# PUBLIC_FIREBASE_AUTH_DOMAIN=""
# PUBLIC_FIREBASE_PROJECT_ID=""
# PUBLIC_FIREBASE_STORAGE_BUCKET=""
# PUBLIC_FIREBASE_SENDER_ID=""
# PUBLIC_FIREBASE_APP_ID=""
# PUBLIC_FIREBASE_MEASUREMENT_ID=""
