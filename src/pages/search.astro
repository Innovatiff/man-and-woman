---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const metaTitle = 'Search';
const metaDescription =
  'Search the full Men Women Psychology library — find any insight by topic, question, or keyword.';
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical="/search"
  noindex={true}
>
  <div class="container search-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Search' }]} />

    <header class="search-head">
      <p class="eyebrow">The whole library</p>
      <h1>Search</h1>
      <p class="lede">
        Find any insight across the site — search by topic, a question you have, or a single word.
      </p>
    </header>

    <div id="search" class="search-ui" role="search"></div>

    <noscript>
      <p class="muted">
        Search needs JavaScript. You can still <a href="/topics/">browse by topic</a> or use the
        <a href="/explore/">Psychology Explorer</a>.
      </p>
    </noscript>

    <p class="search-alt muted">
      Prefer to browse? Try <a href="/topics/">topics</a>, the
      <a href="/explore/">Psychology Explorer</a>, or a
      <a href="/male-psychology/">category</a>.
    </p>
  </div>
</BaseLayout>

<!--
  Pagefind's UI assets live at /pagefind/ and are generated by the `postbuild`
  step (`pagefind --site dist`) after `astro build`. They do not exist during
  `astro dev`, so the box shows a graceful message there and works once deployed.
-->
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', function () {
    var el = document.getElementById('search');
    if (window.PagefindUI) {
      new window.PagefindUI({
        element: '#search',
        showImages: false,
        showSubResults: true,
        pageSize: 8,
        resetStyles: false,
        placeholder: 'Search insights — e.g. "why he pulls away", attachment, trust…',
      });
    } else if (el) {
      el.innerHTML =
        '<p class="muted">The search index is generated at build time — it will be available on the deployed site.</p>';
    }
  });
</script>

<style>
  .search-page {
    max-width: 52rem;
    padding-bottom: var(--space-7);
  }
  .search-head {
    margin: var(--space-4) 0 var(--space-5);
  }
  .search-head h1 {
    margin: var(--space-2) 0 var(--space-3);
  }
  /* Theme the Pagefind UI to the site's brand. */
  .search-ui {
    --pagefind-ui-primary: #dc2626;
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-card);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: inherit;
  }
  .search-alt {
    margin-top: var(--space-5);
    font-size: 0.92rem;
  }
</style>
