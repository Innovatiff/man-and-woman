---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GenderBadge from '../components/GenderBadge.astro';
import DisclaimerBox from '../components/DisclaimerBox.astro';
import { TOPICS } from '../data/topics';
import { SITE } from '../config';
import { allInsights } from '../lib/insights';

// Count matching insights per topic once, from a single pass over the library.
const items = await allInsights();
const countFor = (tags: string[]) => {
  const wanted = new Set(tags);
  return items.filter((i) => i.data.tags.some((t) => wanted.has(t))).length;
};
const topics = TOPICS.map((t) => ({ ...t, count: countFor(t.tags) }));

const metaTitle = 'Topics: Browse the Psychology by Theme';
const metaDescription =
  'Browse Men Women Psychology by theme: attachment, commitment, trust, conflict, emotional intimacy, vulnerability, boundaries, meaning, and more.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: metaTitle,
  description: metaDescription,
  url: `${SITE.url}/topics/`,
  hasPart: topics.map((t) => ({
    '@type': 'CollectionPage',
    name: t.title,
    url: `${SITE.url}/topics/${t.slug}/`,
  })),
};
---

<BaseLayout title={metaTitle} description={metaDescription} canonical="/topics" jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Topics' }]} />
  </div>

  <header class="topics-header">
    <div class="container">
      <p class="eyebrow">The library, by theme</p>
      <h1>Browse by topic</h1>
      <p class="lede">
        Categories organise the library by area. Topics cut across them, clustering every page
        about a single theme, wherever it lives, so you can go deep on what you came for.
      </p>
    </div>
  </header>

  <div class="container topics-body">
    <div class="topics-grid">
      {
        topics.map((t) => (
          <a class="topic-card" href={`/topics/${t.slug}/`}>
            <div class="topic-card-top">
              <GenderBadge focus={t.focus} />
              <span class="topic-count">{t.count}</span>
            </div>
            <h2>{t.title}</h2>
            <p class="muted">{t.blurb}</p>
            <span class="topic-cta">Explore →</span>
          </a>
        ))
      }
    </div>

    <DisclaimerBox />
  </div>
</BaseLayout>

<style>
  .topics-header {
    padding-block: var(--space-5) var(--space-4);
    background: radial-gradient(60% 80% at 100% 0%, rgba(220, 38, 38, 0.06), transparent 70%);
  }
  .topics-header h1 {
    margin: var(--space-2) 0 var(--space-3);
  }
  .topics-body {
    max-width: var(--wide-width);
    margin-top: var(--space-5);
  }
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-4);
  }
  .topic-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .topic-card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .topic-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }
  .topic-count {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
  .topic-card h2 {
    font-size: var(--step-1);
    margin: 0;
  }
  .topic-card .muted {
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .topic-cta {
    margin-top: var(--space-2);
    color: var(--color-primary-strong);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
