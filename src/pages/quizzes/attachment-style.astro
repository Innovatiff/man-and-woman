---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DisclaimerBox from '../../components/DisclaimerBox.astro';
import { SITE } from '../../config';
import { QUESTIONS, SCALE, RESULTS, STYLE_ORDER } from '../../data/quizzes/attachment-style';

const metaTitle = "What's Your Attachment Style? A Free Research-Based Quiz";
const metaDescription =
  'A short, research-based attachment style quiz. See whether you lean secure, anxious, avoidant, or fearful-avoidant, and what it means for your relationships.';

// Escaped so the JSON can never break out of the <script> tag.
const quizData = JSON.stringify({
  questions: QUESTIONS,
  scale: SCALE,
  results: RESULTS,
  styleOrder: STYLE_ORDER,
}).replace(/</g, '\\u003c');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Quiz',
  name: 'Attachment Style Quiz',
  about: 'Adult attachment styles in relationships',
  educationalUse: 'self-assessment',
  url: `${SITE.url}/quizzes/attachment-style/`,
  isAccessibleForFree: true,
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical="/quizzes/attachment-style"
  ogImage="/og/quizzes/attachment-style.png"
  jsonLd={jsonLd}
>
  <div class="container quiz-wrap">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Quizzes', href: '/quizzes' },
        { label: 'Attachment Style' },
      ]}
    />

    <header class="quiz-head">
      <p class="eyebrow">Research-based quiz</p>
      <h1>What's your attachment style?</h1>
      <p class="lede">
        A short reflection on how you tend to bond in close relationships, scored on the two
        dimensions psychologists actually measure: attachment anxiety and attachment avoidance.
      </p>
    </header>

    <div class="quiz-app">
      <!-- INTRO -->
      <section id="quiz-intro" class="quiz-card">
        <h2>Before you start</h2>
        <p>
          There are four broad attachment patterns: <strong>secure</strong>,
          <strong>anxious</strong>, <strong>avoidant</strong>, and
          <strong>fearful-avoidant</strong>. Most people are a blend, and where you land can shift
          over time and even between relationships.
        </p>
        <p class="quiz-note">
          This is an educational self-reflection tool, <strong>not a clinical diagnosis</strong>.
          No result is a fixed label.
        </p>
        <ul class="quiz-meta">
          <li>16 quick questions</li>
          <li>About 2 minutes</li>
          <li>Your answers stay in your browser: nothing is sent or stored</li>
        </ul>
        <button type="button" class="btn btn--primary btn--lg" id="quiz-start">Start the quiz</button>
        <noscript>
          <p class="quiz-note">
            This quiz needs JavaScript. You can still read about the styles in
            <a href="/insights/understanding-attachment-styles/">understanding attachment styles</a>.
          </p>
        </noscript>
      </section>

      <!-- QUESTIONS -->
      <section id="quiz-run" class="quiz-card" hidden aria-live="polite">
        <div class="quiz-progress" aria-hidden="true"><span id="quiz-progress-bar"></span></div>
        <p class="quiz-counter" id="quiz-counter"></p>
        <fieldset class="quiz-question">
          <legend id="quiz-question-text"></legend>
          <div class="quiz-options" id="quiz-options" role="radiogroup" aria-labelledby="quiz-question-text"></div>
        </fieldset>
        <div class="quiz-controls">
          <button type="button" class="btn btn--ghost" id="quiz-back">← Back</button>
          <span class="quiz-hint muted">Pick the option that fits best. There are no right answers.</span>
        </div>
      </section>

      <!-- RESULT (filled by JS) -->
      <section id="quiz-result" class="quiz-card" hidden aria-live="polite"></section>
    </div>

    <DisclaimerBox />
  </div>

  <script type="application/json" id="quiz-data" set:html={quizData}></script>
</BaseLayout>

<script>
  type Dim = 'anxiety' | 'avoidance';
  interface Q { id: string; text: string; dimension: Dim; reverse?: boolean }
  interface Pt { value: number; label: string }
  interface Res {
    id: string; name: string; tagline: string; axes: string;
    description: string[]; strengths: string[]; growth: string[];
    links: { label: string; href: string }[];
  }
  interface Data { questions: Q[]; scale: Pt[]; results: Record<string, Res>; styleOrder: string[] }

  const dataEl = document.getElementById('quiz-data');
  if (dataEl && dataEl.textContent) {
    const data: Data = JSON.parse(dataEl.textContent);
    const { questions, scale, results } = data;

    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const intro = $('quiz-intro');
    const run = $('quiz-run');
    const result = $('quiz-result');
    const bar = $('quiz-progress-bar');
    const counter = $('quiz-counter');
    const qText = $('quiz-question-text');
    const options = $('quiz-options');
    const back = $('quiz-back') as HTMLButtonElement;

    const answers: (number | null)[] = new Array(questions.length).fill(null);
    let idx = 0;

    const view = (v: 'intro' | 'run' | 'result') => {
      intro.hidden = v !== 'intro';
      run.hidden = v !== 'run';
      result.hidden = v !== 'result';
    };

    const renderQuestion = () => {
      const q = questions[idx];
      bar.style.width = `${(idx / questions.length) * 100}%`;
      counter.textContent = `Question ${idx + 1} of ${questions.length}`;
      qText.textContent = q.text;
      options.innerHTML = '';
      scale.forEach((pt) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'quiz-opt';
        b.setAttribute('role', 'radio');
        const checked = answers[idx] === pt.value;
        b.setAttribute('aria-checked', String(checked));
        if (checked) b.classList.add('is-selected');
        b.textContent = pt.label;
        b.addEventListener('click', () => select(pt.value));
        options.appendChild(b);
      });
      back.disabled = idx === 0;
    };

    const select = (v: number) => {
      answers[idx] = v;
      Array.from(options.children).forEach((c) => {
        const el = c as HTMLElement;
        const on = el.textContent === scale.find((s) => s.value === v)?.label;
        el.classList.toggle('is-selected', on);
        el.setAttribute('aria-checked', String(on));
      });
      window.setTimeout(() => {
        if (idx < questions.length - 1) {
          idx++;
          renderQuestion();
        } else {
          finish();
        }
      }, 200);
    };

    back.addEventListener('click', () => {
      if (idx > 0) {
        idx--;
        renderQuestion();
      }
    });

    const scores = () => {
      const anx: number[] = [];
      const avo: number[] = [];
      questions.forEach((q, i) => {
        let v = answers[i] ?? 3;
        if (q.reverse) v = 6 - v;
        (q.dimension === 'anxiety' ? anx : avo).push(v);
      });
      const mean = (a: number[]) => a.reduce((x, y) => x + y, 0) / a.length;
      return { anx: mean(anx), avo: mean(avo) };
    };

    const classify = (anx: number, avo: number): string => {
      const A = anx > 3;
      const V = avo > 3;
      if (!A && !V) return 'secure';
      if (A && !V) return 'anxious';
      if (!A && V) return 'avoidant';
      return 'fearful';
    };

    const pct = (mean: number) => Math.round(((mean - 1) / 4) * 100);

    const li = (items: string[]) => items.map((t) => `<li>${t}</li>`).join('');

    const renderResult = (
      styleId: string,
      s: { anxPct: number; avoPct: number } | null,
    ) => {
      const r = results[styleId];
      const bars = s
        ? `<div class="quiz-scores">
             <div class="quiz-score">
               <div class="quiz-score-head"><span>Attachment anxiety</span><span>${s.anxPct}%</span></div>
               <div class="quiz-score-track"><span style="width:${s.anxPct}%"></span></div>
             </div>
             <div class="quiz-score">
               <div class="quiz-score-head"><span>Attachment avoidance</span><span>${s.avoPct}%</span></div>
               <div class="quiz-score-track"><span style="width:${s.avoPct}%"></span></div>
             </div>
           </div>`
        : `<p class="quiz-shared-note">You're viewing a shared result. Take the quiz to see your own scores.</p>`;

      result.innerHTML = `
        <p class="eyebrow">${s ? 'Your result' : 'Shared result'}</p>
        <h2 class="quiz-result-name">${r.name}</h2>
        <p class="quiz-result-tagline">${r.tagline}</p>
        <p class="quiz-result-axes">${r.axes}</p>
        ${bars}
        <div class="quiz-result-body">
          ${r.description.map((p) => `<p>${p}</p>`).join('')}
          <div class="quiz-result-cols">
            <div><h3>Strengths</h3><ul>${li(r.strengths)}</ul></div>
            <div><h3>Growth edges</h3><ul>${li(r.growth)}</ul></div>
          </div>
          <div class="quiz-result-links">
            <h3>Go deeper</h3>
            <ul>${r.links.map((l) => `<li><a href="${l.href}">${l.label}</a></li>`).join('')}</ul>
          </div>
          <p class="quiz-note">Remember: attachment describes tendencies, not a fixed type. With
            safe relationships and self-awareness, people can and do move toward security
            ("earned security").</p>
        </div>
        <div class="quiz-result-actions">
          <button type="button" class="btn btn--primary" id="quiz-share">Share result</button>
          <button type="button" class="btn btn--ghost" id="quiz-retake">Retake the quiz</button>
        </div>
        <p class="quiz-share-msg muted" id="quiz-share-msg" hidden>Link copied to your clipboard.</p>`;

      const share = document.getElementById('quiz-share');
      const retake = document.getElementById('quiz-retake');
      const msg = document.getElementById('quiz-share-msg') as HTMLElement;
      share?.addEventListener('click', async () => {
        const url = `${location.origin}${location.pathname}?r=${styleId}`;
        const text = `My attachment style is ${r.name}. What's yours?`;
        if (navigator.share) {
          try {
            await navigator.share({ title: 'Attachment Style Quiz', text, url });
          } catch {
            /* user cancelled */
          }
        } else {
          try {
            await navigator.clipboard.writeText(url);
            msg.hidden = false;
          } catch {
            /* clipboard blocked */
          }
        }
      });
      retake?.addEventListener('click', start);
    };

    const finish = () => {
      const { anx, avo } = scores();
      const styleId = classify(anx, avo);
      renderResult(styleId, { anxPct: pct(anx), avoPct: pct(avo) });
      history.replaceState(null, '', `?r=${styleId}`);
      view('result');
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const start = () => {
      answers.fill(null);
      idx = 0;
      history.replaceState(null, '', location.pathname);
      view('run');
      renderQuestion();
    };

    $('quiz-start').addEventListener('click', start);

    // Deep-linked shared result (?r=secure|anxious|avoidant|fearful)
    const param = new URLSearchParams(location.search).get('r');
    if (param && results[param]) {
      renderResult(param, null);
      view('result');
    }
  }
</script>

<!--
  Global (unscoped) because the result card is built at runtime via innerHTML,
  and Astro's scoped styles only match elements present at build time. Every
  selector is .quiz-* / #quiz-* prefixed, so there is no risk of leaking, and the
  block only loads on this page anyway.
-->
<style is:global>
  .quiz-wrap {
    max-width: 48rem;
    padding-bottom: var(--space-7);
  }
  .quiz-head {
    margin: var(--space-4) 0 var(--space-5);
  }
  .quiz-head h1 {
    margin: var(--space-2) 0 var(--space-3);
  }
  .quiz-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 4vw, 2.25rem);
    box-shadow: var(--shadow-sm);
  }
  .quiz-card h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-3);
  }
  .quiz-note {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    background: var(--color-primary-soft);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    margin: var(--space-3) 0;
  }
  .quiz-meta {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0;
    display: grid;
    gap: 0.4rem;
  }
  .quiz-meta li {
    padding-left: 1.6rem;
    position: relative;
    color: var(--color-text-soft);
    font-size: 0.95rem;
  }
  .quiz-meta li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
  }

  /* Progress + question */
  .quiz-progress {
    height: 6px;
    background: var(--color-surface);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: var(--space-3);
  }
  #quiz-progress-bar {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-primary);
    border-radius: 999px;
    transition: width 0.3s ease;
  }
  .quiz-counter {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-weight: 700;
    margin: 0 0 var(--space-3);
  }
  .quiz-question {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .quiz-question legend {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .quiz-options {
    display: grid;
    gap: 0.6rem;
  }
  .quiz-opt {
    text-align: left;
    background: var(--color-card);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
    font: inherit;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.05s ease;
  }
  .quiz-opt:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }
  .quiz-opt:active {
    transform: scale(0.99);
  }
  .quiz-opt.is-selected {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
    box-shadow: inset 0 0 0 1px var(--color-primary);
  }
  .quiz-controls {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }
  .quiz-hint {
    font-size: 0.85rem;
  }

  /* Result */
  .quiz-result-name {
    font-size: var(--step-3);
    margin: var(--space-1) 0 var(--space-2);
    color: var(--color-primary-strong);
  }
  .quiz-result-tagline {
    font-size: var(--step-1);
    color: var(--color-text);
    margin: 0 0 var(--space-1);
  }
  .quiz-result-axes {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    font-weight: 700;
    margin: 0 0 var(--space-4);
  }
  .quiz-scores {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .quiz-score-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .quiz-score-track {
    height: 10px;
    background: var(--color-surface);
    border-radius: 999px;
    overflow: hidden;
  }
  .quiz-score-track span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary), var(--red-500));
    border-radius: 999px;
  }
  .quiz-shared-note {
    background: var(--color-surface);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    font-size: 0.92rem;
    margin-bottom: var(--space-4);
  }
  .quiz-result-body p {
    line-height: 1.7;
    color: var(--color-text-soft);
    margin-bottom: var(--space-3);
  }
  .quiz-result-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
    margin: var(--space-4) 0;
  }
  .quiz-result-cols h3,
  .quiz-result-links h3 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--color-primary-strong);
    margin-bottom: var(--space-2);
  }
  .quiz-result-cols ul,
  .quiz-result-links ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
  }
  .quiz-result-cols li,
  .quiz-result-links li {
    color: var(--color-text-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .quiz-result-links {
    margin-top: var(--space-4);
  }
  .quiz-result-links a {
    color: var(--color-primary-strong);
    font-weight: 600;
    text-decoration: none;
  }
  .quiz-result-links a:hover {
    text-decoration: underline;
  }
  .quiz-result-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }
  .quiz-share-msg {
    margin-top: var(--space-2);
    font-size: 0.9rem;
  }
</style>
