---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../data/categories';
const popular = CATEGORIES.slice(0, 6);
---

<BaseLayout
  title="Page not found"
  description="That page could not be found. Explore Men Women Psychology's psychology library instead."
  canonical="/404"
  noindex
>
  <section class="container notfound">
    <p class="eyebrow">404</p>
    <h1>We couldn't find that page</h1>
    <p class="lede">
      The link may be old or mistyped. Here are some good places to pick up the thread.
    </p>
    <div class="notfound-actions">
      <a href="/" class="btn btn--primary">Back to home</a>
      <a href="/explore/" class="btn btn--ghost">Open the Psychology Explorer</a>
    </div>
    <h2 class="notfound-sub">Popular categories</h2>
    <ul class="notfound-cats">
      {popular.map((c) => <li><a href={`/${c.slug}/`}>{c.name}</a></li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: 42rem;
    padding-block: var(--space-7);
  }
  .notfound-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-6);
  }
  .notfound-sub {
    font-size: var(--step-1);
  }
  .notfound-cats {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .notfound-cats a {
    display: inline-block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    text-decoration: none;
    color: var(--slate);
  }
  .notfound-cats a:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }
</style>
