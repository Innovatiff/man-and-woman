---
import BrandMark from './BrandMark.astro';
import { EDITORIAL_TEAM } from '../config';

export interface Props {
  date: string; // "YYYY-MM"
}
const { date } = Astro.props;

const MONTHS = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];
const [yearStr, monthStr] = date.split('-');
const mi = Number(monthStr) - 1;
const pretty = mi >= 0 && mi < 12 ? `${MONTHS[mi]} ${yearStr}` : date;
---

<div class="byline">
  <span class="byline-mark" aria-hidden="true"><BrandMark id="byline" size={20} /></span>
  <div class="byline-body">
    <p class="byline-by">
      Created by the <a href="/about/">{EDITORIAL_TEAM}</a>
    </p>
    <p class="byline-meta">
      Researched, written, and reviewed for accuracy and balance ·
      <span class="byline-reviewed">Last reviewed <time datetime={date}>{pretty}</time></span> ·
      <a href="/editorial-policy/">Editorial standards</a>
    </p>
  </div>
</div>

<style>
  .byline {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin: var(--space-3) 0 var(--space-4);
  }
  .byline-mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-primary-soft);
    border: 1px solid var(--color-border);
  }
  .byline-body {
    min-width: 0;
  }
  .byline-by {
    margin: 0;
    font-weight: 600;
    color: var(--color-text);
    font-size: 0.95rem;
  }
  .byline-by a {
    color: inherit;
    text-decoration: none;
  }
  .byline-by a:hover {
    color: var(--color-primary-strong);
    text-decoration: underline;
  }
  .byline-meta {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  .byline-meta a {
    color: var(--color-primary-strong);
    text-decoration: none;
  }
  .byline-meta a:hover {
    text-decoration: underline;
  }
</style>
