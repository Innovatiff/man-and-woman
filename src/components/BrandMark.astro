---
/**
 * Brand mark for Men Women Psychology: a clean red heart.
 *
 * Scales with the surrounding wordmark via em units so the lockup stays
 * proportional at every breakpoint. The `tone` controls fill so it reads on
 * both light and dark surfaces; `id` is accepted for call-site compatibility.
 */
export interface Props {
  id?: string;
  tone?: 'light' | 'dark';
  size?: number;
}
const { tone = 'light', size = 24 } = Astro.props;
const fill = tone === 'dark' ? '#ef4444' : '#dc2626';
---

<svg
  class="brandmark"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
    fill={fill}
  ></path>
</svg>

<style>
  .brandmark {
    display: block;
    flex: none;
    height: 1.2em;
    width: auto;
  }
</style>
