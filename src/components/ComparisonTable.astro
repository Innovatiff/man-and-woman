---
/**
 * Comparison table at a glance. Two modes:
 *  - Gendered (default): columns are "Men (avg.)" / "Women (avg.)", framed as
 *    average tendencies with heavy overlap.
 *  - Neutral: pass `leftLabel` and `rightLabel` for topics where the honest
 *    contrast is conceptual (myth vs. reality, experiences vs. possessions,
 *    etc.) rather than gendered. The `men`/`women` keys are just the left/right
 *    column slots.
 */
export interface Row {
  aspect: string;
  men: string;
  women: string;
}
export interface Props {
  rows: Row[];
  title?: string;
  leftLabel?: string;
  rightLabel?: string;
}
const { rows, title, leftLabel, rightLabel } = Astro.props;
const neutral = Boolean(leftLabel && rightLabel);
const heading = title ?? (neutral ? 'At a glance' : 'At a glance: average tendencies');
const note = neutral
  ? 'A side-by-side contrast to make the distinction concrete — patterns and tendencies, not rigid rules.'
  : "Broad averages with heavy overlap — many people differ from their group's tendency. This is a map, not a measurement of any one person.";
---

<section class="cmp" aria-label={heading}>
  <h2 class="cmp-title">{heading}</h2>
  <p class="cmp-note muted">{note}</p>
  <div class="cmp-wrap">
    <table class="cmp-table">
      <thead>
        <tr>
          <th scope="col">Aspect</th>
          {
            neutral ? (
              <Fragment>
                <th scope="col">{leftLabel}</th>
                <th scope="col">{rightLabel}</th>
              </Fragment>
            ) : (
              <Fragment>
                <th scope="col"><span class="badge badge--men">● Men (avg.)</span></th>
                <th scope="col"><span class="badge badge--women">● Women (avg.)</span></th>
              </Fragment>
            )
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row">{r.aspect}</th>
              <td>{r.men}</td>
              <td>{r.women}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .cmp {
    margin: var(--space-6) 0;
  }
  .cmp-title {
    font-size: var(--step-2);
    margin-bottom: var(--space-2);
  }
  .cmp-note {
    font-size: 0.88rem;
    max-width: 60ch;
    margin-bottom: var(--space-3);
  }
  .cmp-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .cmp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.94rem;
    min-width: 34rem;
  }
  .cmp-table th,
  .cmp-table td {
    text-align: left;
    padding: 0.8rem 1rem;
    vertical-align: top;
    border-bottom: 1px solid var(--color-border);
  }
  .cmp-table thead th {
    background: var(--color-surface);
    font-family: var(--font-body);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .cmp-table tbody th[scope='row'] {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-text);
    width: 26%;
    background: var(--color-card);
  }
  .cmp-table td {
    color: var(--color-text-soft);
  }
  .cmp-table tbody tr:last-child th,
  .cmp-table tbody tr:last-child td {
    border-bottom: none;
  }
  .cmp-table tbody tr:nth-child(even) td,
  .cmp-table tbody tr:nth-child(even) th[scope='row'] {
    background: color-mix(in srgb, var(--color-text) 3%, var(--color-card));
  }
</style>
