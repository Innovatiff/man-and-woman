---
import { DISCLAIMER } from '../config';
export interface Props {
  /** Override the default disclaimer text. */
  text?: string;
  compact?: boolean;
}
const { text = DISCLAIMER, compact = false } = Astro.props;
---

<aside class={`disclaimer-box${compact ? ' disclaimer-box--compact' : ''}`} role="note">
  <span class="disclaimer-icon" aria-hidden="true">ⓘ</span>
  <p>{text}</p>
</aside>

<style>
  .disclaimer-box {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-text-muted);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    margin: var(--space-5) 0;
  }
  .disclaimer-box p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .disclaimer-icon {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.4;
    flex: none;
  }
  .disclaimer-box--compact {
    margin: var(--space-3) 0;
  }
</style>
