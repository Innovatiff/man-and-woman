---
/** The "honest answer box": the core finding, stated plainly, first. */
export interface Props {
  text: string;
}
const { text } = Astro.props;
---

<aside class="core-finding" aria-label="The core finding">
  <p class="core-finding-label">The honest answer</p>
  <p class="core-finding-text">{text}</p>
</aside>

<style>
  .core-finding {
    background: linear-gradient(180deg, var(--red-50), #fff);
    border: 1px solid var(--red-100);
    border-left: 5px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-4) 0 var(--space-6);
    box-shadow: var(--shadow-sm);
  }
  .core-finding-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--color-primary-strong);
    margin: 0 0 var(--space-2);
  }
  .core-finding-text {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.4;
    color: var(--slate);
    margin: 0;
  }
</style>
